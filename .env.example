# FIREBOX AI server configuration; never place secrets in frontend code.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/firebox_ai?retryWrites=true&w=majority
MONGODB_DB_NAME=firebox_ai
FIREBOX_OWNER_ID=firebox-owner

# Required before the workspace API and UI can be used.
APP_USERNAME=
APP_PASSWORD=

# Local FIREBOX checkpoint produced by training/train_firebox.py.
FIREBOX_CHECKPOINT=/app/storage/checkpoints/latest.pt

# Optional: required only when users enable web search.
TAVILY_API_KEY=

# Use a Railway volume mounted at /app/storage in production.
STORAGE_DIR=/app/storage
CORS_ORIGINS=http://localhost:3000
